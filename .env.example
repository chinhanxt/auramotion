# App
# Cổng app (scripts/start-all.sh). APP_URL phải khớp cổng này, dùng trong link email.
PORT=3000
APP_URL=http://localhost:3000
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (bỏ trống AUTH_GOOGLE_ID thì tắt đăng nhập Google)
# Redirect URI: ${APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database & Queue (docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auramotion
REDIS_URL=redis://localhost:6379

# Lưu file kết quả trên ổ đĩa, phục vụ qua /media/...
STORAGE_DIR=./data/storage

# Thanh toán QR (VietQR Quick Link img.vietqr.io, miễn phí)
# BANK_ID: mã BIN hoặc tên viết tắt ngân hàng (vd 970436 hoặc vietcombank)
BANK_ID=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
# Khóa ký webhook: header x-signature = HMAC-SHA256 hex của body
PAYMENT_WEBHOOK_SECRET=

# MUSE (muse2api). Cổng muse2api do start-all.sh chạy lấy từ MUSE_API_URL.
MUSE_API_URL=http://127.0.0.1:18610
# Key gọi /v1/* của muse2api (start-all.sh truyền cho muse2api làm MUSE2API_API_KEY). Tạo bằng: openssl rand -hex 24
MUSE_API_KEY=
# Thư mục repo muse2api đã tạo .venv (bắt buộc cho start-all.sh và scripts/muse2api-mock.sh)
MUSE2API_DIR=
# browser = Muse thật (cần Chromium + cookie tài khoản), mock = dữ liệu giả không tốn lượt
MUSE2API_DRIVER=browser
# Dữ liệu muse2api: tài khoản, cookie, media
MUSE2API_DATA_DIR=./data/muse2api
# Admin key muse2api (dashboard /dashboard, scripts/muse-keepalive.sh). Bỏ trống thì dùng MUSE_API_KEY.
MUSE2API_ADMIN_KEY=
# Số job MUSE chạy cùng lúc (theo số tài khoản Muse trong muse2api)
MUSE_CONCURRENCY=3
# Số lệnh agy / codex chạy cùng lúc
CLI_CONCURRENCY=1

# CLI agy / codex (viết prompt, tạo ảnh). Bỏ trống thì dùng lệnh trong PATH và thư mục đăng nhập mặc định.
AGY_BIN=
# Thư mục đăng nhập agy, mặc định ~/.gemini/antigravity-cli
AGY_HOME=
CODEX_BIN=
# Thư mục đăng nhập codex, mặc định ~/.codex
CODEX_HOME=

# Giọng đọc + ghép video. Bỏ trống thì dùng vieneu-say trong PATH và python3.
VIENEU_BIN=
# Python chạy tools/post/assemble.py
ASSEMBLE_PY=

# Tài khoản Admin tạo khi chạy npm run db:seed
SEED_ADMIN_EMAIL=admin@auramotion.local
SEED_ADMIN_PASSWORD=

# Gửi mail (nhắc gia hạn, quên mật khẩu). Bỏ trống SMTP_HOST thì chỉ in ra log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
