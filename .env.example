# App
APP_URL=http://localhost:3000
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (bỏ trống AUTH_GOOGLE_ID thì tắt đăng nhập Google)
# Redirect URI: ${APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database & Queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auramotion
REDIS_URL=redis://localhost:6379

# Lưu file kết quả trên ổ đĩa, phục vụ qua /media/...
STORAGE_DIR=./data/storage

# Payment webhook
PAYMENT_WEBHOOK_SECRET=

# MUSE (muse2api)
MUSE_API_URL=http://127.0.0.1:18610
MUSE_API_KEY=
# Thư mục repo muse2api (dùng cho scripts/muse2api-mock.sh)
MUSE2API_DIR=
# Số job worker chạy cùng lúc (theo số tài khoản Muse trong muse2api)
MUSE_CONCURRENCY=3

# Mã hóa dữ liệu nhạy cảm lưu trong DB
ENCRYPTION_KEY=

# Tài khoản Admin tạo khi chạy npm run db:seed
SEED_ADMIN_EMAIL=admin@auramotion.local
SEED_ADMIN_PASSWORD=

# Gửi mail (nhắc gia hạn, quên mật khẩu). Bỏ trống SMTP_HOST thì chỉ in ra log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
