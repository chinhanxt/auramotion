APP_URL=http://localhost:3000
AUTH_SECRET=test-auth-secret-not-for-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auramotion_test
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./data/test-storage
MUSE_API_URL=http://127.0.0.1:18611
MUSE_API_KEY=dev-muse-key
MUSE_CONCURRENCY=3
SEED_ADMIN_EMAIL=admin@auramotion.local
SEED_ADMIN_PASSWORD=test-admin-password
BANK_ID=970436
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=AURAMOTION TEST
PAYMENT_WEBHOOK_SECRET=test-webhook-secret
# Không tạo model "MUSE Ảnh 2" khi test (loadEnv đọc cả .env)
SEED_MUSE_IMAGE_ACCOUNT=
# agy viết chữ qua CLI giả (tests/fixtures/fake-agy.sh); test ACP tự dựng pool với agent giả.
AGY_TRANSPORT=cli
# codex viết chữ qua `codex exec` giả; test app-server tự dựng tiến trình giả.
CODEX_TRANSPORT=exec
# Dữ liệu chạy (pool ACP, profile codex, proxy) của test
AURA_DATA_DIR=./data/test-runtime
CODEX_PROFILES_DIR=./data/test-runtime/codex-profiles
