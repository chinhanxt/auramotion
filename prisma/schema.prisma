generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum PlanCode {
  free
  pro
  ultra
}

enum BillingPeriod {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum CreditTxnType {
  grant
  purchase
  hold
  charge
  refund
  admin_adjust
  expire
}

enum CreditBucket {
  PLAN
  PURCHASED
}

enum ModelProvider {
  MUSE
  AGY
  CODEX
  LOCAL
}

enum JobKind {
  IMAGE
  VIDEO
  ASSEMBLE
}

enum PresetKind {
  STYLE
  CAMERA
}

enum SkillKind {
  IMAGE
  VIDEO
  STORY
  SCRIPT
}

enum StoryMode {
  PARALLEL
  CHAIN
}

enum StoryStatus {
  PLANNING
  READY
  RENDERING
  ASSEMBLING
  DONE
  FAILED
  CANCELED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PaymentType {
  PLAN
  CREDIT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  name         String
  avatarUrl    String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  resetTokens   PasswordResetToken[]
  subscriptions Subscription[]
  transactions  CreditTransaction[]
  jobs          Job[]
  payments      Payment[]
  stories       Story[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Plan {
  id             String   @id @default(cuid())
  code           PlanCode @unique
  name           String
  priceMonth     Int
  priceYear      Int
  monthlyCredits Decimal  @db.Decimal(12, 2)
  maxConcurrent  Int
  maxDurationSec Int
  rank           Int

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  planId      String
  period      BillingPeriod
  startAt     DateTime           @default(now())
  endAt       DateTime?
  nextGrantAt DateTime
  status      SubscriptionStatus @default(ACTIVE)
  remindedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

model CreditTransaction {
  id        String        @id @default(cuid())
  userId    String
  type      CreditTxnType
  bucket    CreditBucket
  amount    Decimal       @db.Decimal(12, 2)
  jobId     String?
  storyId   String?
  paymentId String?
  actorId   String?
  note      String?
  createdAt DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id])
  story   Story?   @relation(fields: [storyId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([storyId])
  @@map("credit_transactions")
}

model AiModel {
  id          String        @id @default(cuid())
  name        String        @unique
  provider    ModelProvider
  engineModel String
  kind        JobKind
  minPlanRank Int           @default(0)
  baseCost    Decimal       @db.Decimal(12, 2)
  options     Json          @default("{}")
  enabled     Boolean       @default(true)
  sort        Int           @default(0)
  // Hãng hiển thị cho người dùng: muse | google | anthropic | openai | local.
  vendor      String        @default("")
  // Tên đẹp, vd "Gemini 3.8 Flash"; `name` vẫn là khóa nội bộ duy nhất.
  displayName String        @default("")
  // Nhãn ngắn: "Nhanh", "Đẹp", "Mới", "Pro"…
  badge       String        @default("")
  description String        @default("")
  // Thời gian ước tính (giây) hiển thị cho người dùng.
  etaSec      Int?
  // Kết quả test vẽ thật: { ok, testedAt, ms, error?, sampleUrl? }.
  verified    Json?
  // manual | synced (tạo bởi Đồng bộ model).
  source      String        @default("manual")

  jobs Job[]

  @@map("models")
}

model Preset {
  id           String     @id @default(cuid())
  kind         PresetKind
  name         String
  promptSuffix String
  thumbnailUrl String?
  enabled      Boolean    @default(true)
  slug         String?    @unique
  category     String     @default("")
  description  String     @default("")
  // CSS gradient hoặc URL ảnh bìa.
  cover        String?
  palette      String[]   @default([])
  sort         Int        @default(0)
  featured     Boolean    @default(false)

  @@unique([kind, name])
  @@map("presets")
}

model Job {
  id         String    @id @default(cuid())
  userId     String
  modelId    String
  kind       JobKind
  prompt     String
  params     Json      @default("{}")
  inputUrl   String?
  status     JobStatus @default(PENDING)
  cost       Decimal   @db.Decimal(12, 2)
  museTaskId String?
  resultUrls String[]  @default([])
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  deletedAt  DateTime?
  expiresAt  DateTime?
  storyId    String?
  shotIndex  Int?
  progress   Int       @default(0)
  featured   Boolean   @default(false)
  // Lúc đưa vào hàng đợi; null = cảnh CHAIN đang chờ cảnh trước.
  queuedAt   DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  model        AiModel             @relation(fields: [modelId], references: [id])
  story        Story?              @relation(fields: [storyId], references: [id], onDelete: SetNull)
  transactions CreditTransaction[]

  @@index([userId])
  @@index([status])
  @@index([storyId])
  @@index([featured])
  @@map("jobs")
}

model PromptSkill {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  kind         SkillKind
  description  String    @default("")
  // Lĩnh vực (Review sản phẩm, Bán hàng, Thời trang, Gia dụng, Làm phim, Vlog…) + từ khóa không dấu cho bộ chọn skill.
  category     String    @default("")
  tags         String[]  @default([])
  instructions String    @db.Text
  // Biến: {{idea}} {{style}} {{camera}} {{aspect}} {{duration}} {{shots}}
  template     String    @db.Text
  minPlanRank  Int       @default(0)
  enabled      Boolean   @default(true)
  sort         Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("prompt_skills")
}

model Story {
  id              String      @id @default(cuid())
  userId          String
  title           String      @default("")
  idea            String      @db.Text
  skillId         String?
  styleId         String?
  cameraId        String?
  aspect          String
  shotCount       Int
  shotDurationSec Int
  mode            StoryMode   @default(PARALLEL)
  autoRun         Boolean     @default(false)
  autoAssemble    Boolean     @default(false)
  assemble        Json        @default("{}")
  status          StoryStatus @default(PLANNING)
  plan            Json        @default("{}")
  // Khóa hội thoại Muse (chat chính).
  threadKey       String
  planner         String
  planCost        Decimal     @default(0) @db.Decimal(12, 2)
  error           String?
  finalJobId      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs         Job[]
  transactions CreditTransaction[]

  @@index([userId])
  @@index([status])
  @@map("stories")
}

model Payment {
  id            String         @id @default(cuid())
  userId        String
  type          PaymentType
  planCode      PlanCode?
  period        BillingPeriod?
  creditAmount  Decimal?       @db.Decimal(12, 2)
  amount        Int
  refCode       String         @unique
  status        PaymentStatus  @default(PENDING)
  providerTxnId String?        @unique
  paidAt        DateTime?
  confirmedBy   String?
  createdAt     DateTime       @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([userId])
  @@map("payments")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}
